{
  "name": "gestao-financeira",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "predev": "node scripts/prepare-pdfjs.mjs",
    "dev": "expo start --port 8081",
    "preweb": "node scripts/prepare-pdfjs.mjs",
    "web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild": "node scripts/prepare-pdfjs.mjs",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo/metro-runtime": "57.0.16",
    "@expo/vector-icons": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.2",
    "expo": "57.0.26",
    "expo-auth-session": "57.0.13",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "57.0.3",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.4",
    "@types/react-test-renderer": "19.1.0",
    "react-test-renderer": "19.2.3",
    "supabase": "2.119.0",
    "typescript": "6.0.3",
