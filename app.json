{
  "expo": {
    "name": "Gestão",
    "slug": "gestao-financeira",
    "scheme": "gestao",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      "expo-status-bar",
      "expo-sharing"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
