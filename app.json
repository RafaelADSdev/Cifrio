{
  "expo": {
    "name": "Cifrio",
    "slug": "gestao-financeira",
    "scheme": "gestao",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F8FC"
    },
    "android": {
      "package": "com.cifrio.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#F4F8FC"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      "expo-web-browser",
      ["expo-image-picker", { "photosPermission": "Permita ao Cifrio selecionar uma foto para o seu perfil.", "cameraPermission": false, "microphonePermission": false }]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/cifrio-mark.png"
    },
    "ios": {
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
